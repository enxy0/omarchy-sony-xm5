_message() {
  cat <<'EOF'
==> Start the daemon as your user (packages do not start user services):
      systemctl --user enable --now sony-headphones.service
==> Add the bar widget, if you have not yet:
      omarchy plugin add https://github.com/enxy0/omarchy-sony-xm5 --enable
EOF
}

post_install() {
  _message
}

post_upgrade() {
  echo "==> Restart the daemon to run the new version:"
  echo "      systemctl --user restart sony-headphones.service"
}
