#!/usr/bin/env bash
# Builds and installs the sony-headphones daemon and sony-ctl for the
# current user, and enables the Omarchy widget.
#
# Run it from the plugin directory that `omarchy plugin add` created, or from
# a development clone. See `setup --help`.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
BIN_DIR="$HOME/.local/bin"
UNIT_DIR="$HOME/.config/systemd/user"
UNIT=sony-headphones.service
PLUGINS_DIR="$HOME/.config/omarchy/plugins"
BUILD_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-sony-xm5/build"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/sony-headphones"
# The plugin id before the project was renamed.
OLD_ID=io.github.androydified.omasony

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: setup [--uninstall]

Without options:
  1. On Arch, installs the missing build packages (cmake, ninja, gcc,
     bluez-libs, dbus) with pacman.
  2. Builds the daemon and sony-ctl in ~/.cache/omarchy-sony-xm5/build.
  3. Installs sony-headphones-daemon and sony-ctl into ~/.local/bin.
  4. Installs sony-headphones.service as a systemd user unit, enables it and
     (re)starts it.
  5. Enables the Omarchy widget. From a development clone it first copies
     the widget files into ~/.config/omarchy/plugins/<id>.
Run it again after `omarchy plugin update` to update the daemon.

  --uninstall   Stop and remove the daemon, sony-ctl, the user unit, the
                status file and the build directory. The widget stays;
                remove it with `omarchy plugin remove <id>`.
  -h, --help    Show this help.
EOF
}

plugin_id() {
  sed -n 's/^[[:space:]]*"id":[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT_DIR/manifest.json" | head -n 1
}

have() { command -v "$1" >/dev/null 2>&1; }

install_build_deps() {
  if ! have pacman; then
    say "Not an Arch system: install CMake, Ninja, pkg-config, a C++20 compiler and the BlueZ and D-Bus development files yourself"
    return
  fi
  local missing=() pkg
  for pkg in cmake ninja pkgconf bluez-libs dbus; do
    pacman -Q "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
  done
  if ! have g++ && ! have clang++; then
    missing+=(gcc)
  fi
  if ((${#missing[@]} > 0)); then
    say "Installing build packages: ${missing[*]}"
    sudo pacman -S --needed --noconfirm "${missing[@]}"
  fi
}

build() {
  # A build directory configured from another checkout cannot be reused.
  local cache="$BUILD_DIR/CMakeCache.txt"
  if [[ -f $cache ]] && ! grep -qxF "CMAKE_HOME_DIRECTORY:INTERNAL=$ROOT_DIR" "$cache"; then
    rm -rf "$BUILD_DIR"
  fi
  say "Building in $BUILD_DIR"
  mkdir -p "$BUILD_DIR"
  local log="$BUILD_DIR/setup-build.log"
  if ! { cmake -S "$ROOT_DIR" -B "$BUILD_DIR" -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF &&
    cmake --build "$BUILD_DIR"; } >"$log" 2>&1; then
    tail -n 30 "$log" >&2
    die "the build failed; full log: $log"
  fi
}

# Writes next to the target and renames, so a running daemon binary is
# replaced rather than overwritten.
install_file() {
  local mode=$1 src=$2 dest=$3
  install -D -m "$mode" "$src" "$dest.new"
  mv -f "$dest.new" "$dest"
}

install_daemon() {
  say "Installing sony-headphones-daemon and sony-ctl into $BIN_DIR"
  install_file 0755 "$BUILD_DIR/daemon/sony-headphones-daemon" "$BIN_DIR/sony-headphones-daemon"
  install_file 0755 "$BUILD_DIR/cli/sony-ctl" "$BIN_DIR/sony-ctl"

  say "Starting $UNIT"
  install_file 0644 "$ROOT_DIR/daemon/$UNIT" "$UNIT_DIR/$UNIT"
  systemctl --user daemon-reload
  systemctl --user enable "$UNIT" >/dev/null 2>&1
  systemctl --user restart "$UNIT"
}

# Removes the widget installed under the old plugin id, and copies older
# setups left where Omarchy no longer looks.
remove_old_widgets() {
  local id=$1 dir
  if [[ -d $PLUGINS_DIR/$OLD_ID ]]; then
    say "Removing the widget installed under the old id $OLD_ID"
    if have omarchy; then
      omarchy plugin disable "$OLD_ID" >/dev/null 2>&1 || true
    fi
    rm -rf "${PLUGINS_DIR:?}/$OLD_ID"
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  fi
  for dir in "$HOME/.local/share/omarchy/shell/plugins/$OLD_ID" "$HOME/.local/share/omarchy/shell/plugins/$id"; do
    [[ -d $dir ]] && rm -rf "$dir"
  done
  return 0
}

# From a development clone: copies the widget files into the plugin
# directory. A plugin directory that is a git checkout came from
# `omarchy plugin add` and is left alone.
copy_widget() {
  local id=$1 dest="$PLUGINS_DIR/$1" file
  if [[ -e $dest/.git ]]; then
    warn "$dest was installed with 'omarchy plugin add'; not overwriting it with this clone"
    return
  fi
  say "Copying the widget into $dest"
  mkdir -p "$dest"
  find "$dest" -maxdepth 1 -type f \( -name '*.qml' -o -name '*.js' -o -name manifest.json \) -delete
  (
    cd "$ROOT_DIR"
    shopt -s nullglob
    for file in manifest.json *.qml *.js; do
      install -m 0644 "$file" "$dest/$file"
    done
  )
  # The panel's Install and Update buttons run <plugin dir>/setup; the copy has
  # no sources, so that setup runs this clone's.
  printf '#!/usr/bin/env bash\n# Written by %s/setup: this widget is a copy of that clone.\nexec %q "$@"\n' \
    "$ROOT_DIR" "$ROOT_DIR/setup" >"$dest/setup.new"
  chmod 0755 "$dest/setup.new"
  mv -f "$dest/setup.new" "$dest/setup"
}

enable_widget() {
  local id=$1
  if ! have omarchy; then
    say "omarchy not found: enable the widget '$id' in your shell yourself"
    return
  fi
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  if omarchy plugin list --json 2>/dev/null | jq -e --arg id "$id" 'any(.[]; .id == $id and .enabled == true)' >/dev/null 2>&1; then
    return
  fi
  # Next to the widget of the old id, if that one is on the bar.
  local placement=(--section right)
  if omarchy plugin list --json 2>/dev/null | jq -e --arg id "$OLD_ID" 'any(.[]; .id == $id and .enabled == true)' >/dev/null 2>&1; then
    placement=(--after "$OLD_ID")
  fi
  say "Enabling the widget $id"
  omarchy plugin enable "$id" "${placement[@]}" >/dev/null 2>&1 ||
    warn "could not enable the widget; run: omarchy plugin enable $id"
}

do_install() {
  local id
  id="$(plugin_id)"
  [[ -n $id ]] || die "cannot read the plugin id from $ROOT_DIR/manifest.json"

  install_build_deps
  build
  install_daemon
  if [[ $ROOT_DIR != "$(cd "$PLUGINS_DIR/$id" 2>/dev/null && pwd -P)" ]]; then
    copy_widget "$id"
  fi
  enable_widget "$id"
  remove_old_widgets "$id"

  say "Done. Daemon log: journalctl --user -u ${UNIT%.service} -f"
}

do_uninstall() {
  local id
  id="$(plugin_id)"
  say "Stopping and removing $UNIT"
  systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true
  rm -f "$UNIT_DIR/$UNIT"
  systemctl --user daemon-reload
  say "Removing sony-headphones-daemon, sony-ctl, the status file and the build directory"
  rm -f "$BIN_DIR/sony-headphones-daemon" "$BIN_DIR/sony-ctl"
  rm -rf "$STATE_DIR" "$(dirname "$BUILD_DIR")"
  say "Done. Remove the widget with: omarchy plugin remove $id"
}

case "${1:-}" in
  "") do_install ;;
  --uninstall) do_uninstall ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
